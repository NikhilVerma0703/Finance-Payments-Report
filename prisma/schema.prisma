// Finance Reports — Pacific Surfaces
//
// Customer payment tracking as a standalone application: customers, invoices,
// receipts, credit/debit notes, the correction history, the uploaded sheets,
// and the rules and settings the calculations use.
//
// Local-first: a SQLite file, no Docker, no database server to install.
// Every table keeps the `pt_` prefix it had inside the Accounts ERP, so the
// data carried over from that project is read as it is.
//
// Almost every column is nullable. A record can be saved with whatever is known
// now and completed later; what cannot be calculated from what is present is
// reported as *requiring verification*, never guessed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model PtCustomer {
  id   String  @id @default(cuid())
  name String?

  country             String?
  currency            String?
  defaultPaymentTerms String?
  consignee           String?
  notifyParty         String?
  contact             String?
  notes               String?


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices  PtInvoice[]
  edits     PtFieldEdit[]
  onAccount PtOnAccount[]
  /// Where chasing its overdue money stands (PtFollowUp).
  followUp  PtFollowUp?

  @@index([name])
  @@map("pt_customers")
}

model PtInvoice {
  id String @id @default(cuid())

  /// Nullable: an invoice can be entered before anyone says whose it is, and
  /// those are grouped under "No customer recorded" rather than refused.
  customerId String?
  customer   PtCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  invoiceNo            String?
  invoiceDate          DateTime?
  customerInvoiceValue Float?
  /// The customs / as-per-books value, where it differs from the customer's.
  customsInvoiceValue  Float?
  /// Home currency per one unit of foreign currency, on the invoice date.
  exchangeRate         Float?
  currency             String?
  consignee            String?
  notifyParty          String?
  country              String?

  paymentTerms String?
  /// A due date typed in or taken from a sheet. Used in preference to the
  /// calculated one, and always labelled as unverifiable, because the basis it
  /// came from is not recorded.
  enteredDueDate DateTime?

  piNo             String?
  poNo             String?
  shippingBillNo   String?
  shippingBillDate DateTime?
  blNo             String?
  blDate           DateTime?
  containerNo      String?
  eta              DateTime?
  /// When the documents were presented to the bank. The basis a CAD term needs,
  /// and the one no outstanding sheet records.
  docsPresentedDate DateTime?

  /// Balance as per books, entered from the books. Never part of the
  /// outstanding calculation — it already has its own receipts applied, so
  /// subtracting ours again would count them twice. Held beside the calculated
  /// figure so the difference between them can be reported.
  booksBalance Float?

  remarks       String?
  followUpNotes String?

  /// MANUAL | EXCEL
  source     String  @default("MANUAL")
  sourceFile String?
  sourceRow  Int?
  /// The position date of the sheet this came from.
  sourceAsOn DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  receipts   PtReceipt[]
  notes      PtNote[]
  edits      PtFieldEdit[]
  /// Marked completed: settled and moved out of the active lists (PtCompleted).
  completion PtCompleted?

  @@index([customerId])
  @@index([invoiceNo])
  @@index([poNo])
  @@index([invoiceDate])
  @@map("pt_invoices")
}

/// One receipt against one invoice. No limit, and no unique constraint on seq,
/// so Add Receipt can always add another.
model PtReceipt {
  id        String    @id @default(cuid())
  invoiceId String
  invoice   PtInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  seq         Int       @default(1)
  receiptDate DateTime?
  /// Amount received in the invoice's own currency.
  amountFcy   Float?
  /// Home currency per one unit of foreign currency, on the day it arrived.
  exchangeRate Float?
  bankRef      String?
  remarks      String?

  /// Set when this receipt is part of a payment first held on account against
  /// the customer and attributed to this invoice afterwards.
  onAccountId String?
  onAccount   PtOnAccount? @relation(fields: [onAccountId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([onAccountId])
  @@map("pt_receipts")
}

model PtNote {
  id        String    @id @default(cuid())
  invoiceId String
  invoice   PtInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  /// CREDIT | DEBIT
  noteType String    @default("CREDIT")
  noteNo   String?
  noteDate DateTime?
  amount   Float?
  reason   String?

  /// Set when this note was first raised against the customer and attributed
  /// to this invoice afterwards.
  onAccountId String?
  onAccount   PtOnAccount? @relation(fields: [onAccountId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([onAccountId])
  @@map("pt_notes")
}

/// Money received from a customer, or a credit or debit note raised to one,
/// before anybody has said which invoice it is for.
///
/// Accounts often has to book the amount first — a remittance with no invoice
/// number, a claim settled as a lump sum — and attribute it later. It is held
/// here against the customer, and each attribution becomes an ordinary receipt
/// or note on the invoice it is attributed to, carrying `onAccountId`. What is
/// still unattributed is never stored: it is the amount less those receipts or
/// notes, worked out on read, so it can never disagree with the invoices.
model PtOnAccount {
  id         String     @id @default(cuid())
  customerId String
  customer   PtCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// RECEIPT | CREDIT | DEBIT
  kind         String    @default("RECEIPT")
  entryDate    DateTime?
  /// In `currency` — the customer's own when left blank.
  amount       Float?
  currency     String?
  /// Home currency per one unit of foreign currency, on the day it arrived.
  exchangeRate Float?
  /// Bank reference for a payment, the note number for a note.
  reference    String?
  remarks      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  receipts PtReceipt[]
  notes    PtNote[]

  @@index([customerId])
  @@map("pt_on_account")
}

/// One change to one field, whatever kind of record it was on.
///
/// Every write in this section goes through `recordEdits`, so an imported figure
/// that somebody corrected by hand can always be told apart from one the sheet
/// supplied — and `recordSource` says which kind of record it was, so the screen
/// can report "the uploaded sheet said 26,756.27" beside a hand-typed figure.
///
/// Deliberately one table for all four record kinds rather than four tables:
/// an invoice's history has to read as one list, and a receipt or a note is part
/// of its invoice's story, not a separate one.
model PtFieldEdit {
  id String @id @default(cuid())

  /// INVOICE | RECEIPT | NOTE | CUSTOMER | ON_ACCOUNT
  entity   String
  /// The id of that record. Kept even for a receipt or note that is later
  /// deleted, so the history does not develop holes.
  entityId String

  /// The invoice this change belongs to, where there is one — an invoice's own
  /// fields, its receipts' and its notes' all carry the same invoiceId.
  invoiceId String?
  invoice   PtInvoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  customerId String?
  customer   PtCustomer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  fieldKey String
  /// The field's name as the form shows it, stored so the history stays readable
  /// after a label is reworded.
  label    String?
  oldValue String?
  newValue String?

  /// MANUAL | EXCEL — where the record itself came from, at the time of the
  /// edit. This is what lets an imported value be identified as overwritten.
  recordSource String?

  editedBy  String   @default("Accounts")
  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([customerId])
  @@index([entity, entityId])
  @@map("pt_field_edits")
}

/// One upload of one customer sheet, with the file, so an import can always be
/// explained and re-run.
model PtImport {
  id        String @id @default(cuid())
  fileName  String
  sheetName String
  sha256    String

  customerName String?
  /// The date the figures are as at, and where it was found: a cell, the tab
  /// name, a block caption, or a TODAY() formula — which means the sheet had no
  /// fixed position date at all.
  asOn       DateTime?
  asOnSource String?

  currency       String?
  currencySource String?

  rowsRead  Int @default(0)
  created   Int @default(0)
  updated   Int @default(0)
  skipped   Int @default(0)

  /// JSON: the column mapping used, per-row changes, duplicates and warnings.
  report   String @default("{}")
  warnings String @default("[]")

  content   Bytes
  createdAt DateTime @default(now())

  @@index([customerName])
  @@index([sha256])
  @@map("pt_imports")
}


/// A payment-term wording the business has defined itself.
///
/// Checked before the built-in readings, so a wording the system does not
/// understand — or understands differently from how a customer applies it — can
/// be given its exact meaning once, and every invoice carrying it, every
/// dashboard figure and every export follows.
model PtTermRule {
  id        String @id @default(cuid())
  /// A short name for the rule, e.g. "Terry Stone standard".
  name      String
  /// The wording to recognise.
  matchText String
  /// EXACT — the whole wording, ignoring case and spacing; CONTAINS — anywhere in it.
  matchMode String @default("EXACT")
  /// JSON: [{ "percent": 70, "days": 0, "basis": "DOCS_PRESENTED" }, …], adding up to 100.
  milestones String @default("[]")
  active     Boolean @default(true)
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pt_term_rules")
}

/// One client from the main ERP's client list, copied here for its defaults.
///
/// Read-only to the rest of this module: it is replaced as a whole by uploading
/// the list again, and nothing here is ever written back to the ERP. A customer
/// with no currency of its own takes the currency of the client it matches by
/// name; a currency set on the customer here always wins, so a wrong ERP
/// default is corrected in this module without touching the ERP.
model PtErpClient {
  id           String  @id @default(cuid())
  name         String
  /// `clientKey(name)`: lower case, punctuation and legal suffixes removed.
  nameKey      String  @unique
  country      String?
  currency     String?
  paymentTerms String?
  /// The file it was read from.
  source       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pt_erp_clients")
}

/// The adjustable thresholds the status and attention rules use.
model PtSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("pt_settings")
}

/// A fully settled invoice somebody marked completed (owner, 25 Oct 2026: "mark
/// fully settled invoices as completed and move them out of the active
/// outstanding list without permanently deleting their records"). The invoice
/// and its history are untouched; deleting this row puts it back in the active
/// lists. One row per invoice.
model PtCompleted {
  invoiceId       String    @id
  invoice         PtInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  completedAt     DateTime  @default(now())
  completedByName String?
  note            String?

  @@map("pt_completed")
}

/// Where chasing a customer's overdue money stands (owner, 26 Oct 2026: "Allow
/// authorized users to update follow-up status and next action"). One row per
/// customer; every change is in the customer's correction history.
model PtFollowUp {
  customerId    String     @id
  customer      PtCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// NOT_STARTED | CONTACTED | PROMISED | DISPUTED | ESCALATED | RESOLVED
  status        String     @default("NOT_STARTED")
  nextAction    String?
  nextDate      DateTime?
  updatedByName String?
  updatedAt     DateTime   @updatedAt

  @@map("pt_follow_ups")
}
